<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="EpubReader.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:EpubReader"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="EpubReader"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="Base" />
    </Window.SystemBackdrop>

    <Grid MinWidth="300" MinHeight="200">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!--  菜单  -->
            <RowDefinition Height="*" />
            <!--  阅读区域  -->
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <!--  目录栏  -->
            <ColumnDefinition Width="*" />
            <!--  阅读栏  -->
        </Grid.ColumnDefinitions>



        <!--  左侧目录  -->
        <ListView x:ConnectionId='2' x:Name="ChapterList"                                                >
            <ListView.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!--  右侧阅读区域  -->
        <WebView2 x:ConnectionId='3' x:Name="ReadingView" Grid.Column="1" />

        <!--  标题栏  -->
        <TitleBar x:ConnectionId='4'
            x:Name="TitleBar"
            Title="EpubReader"
            IsBackButtonVisible="False"
            IsPaneToggleButtonVisible="True"
            Subtitle="">

            <!--(搜索框) TitleBar.Content>
                <AutoSuggestBox
                    Width="200"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    PlaceholderText="Search.."
                    QueryIcon="Find" />
            </TitleBar.Content-->
            <TitleBar.IconSource>
                <FontIconSource Glyph="&#xE8F1;" />
            </TitleBar.IconSource>
        </TitleBar>

    </Grid>
</Window>

